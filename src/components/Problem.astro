---
const pains = [
  {
    icon: '🔍',
    title: 'Invisible on Google',
    desc: 'When someone searches for your service in Miami, your competitors come up first — and you don\'t show up at all.',
    delay: '0',
  },
  {
    icon: '📱',
    title: 'Broken on Phones',
    desc: 'Over 70% of searches happen on mobile. If your site isn\'t mobile-friendly, visitors leave in seconds.',
    delay: '80',
  },
  {
    icon: '😬',
    title: 'Looks Unprofessional',
    desc: 'Customers instantly judge your business by your website. A bad site means a business they don\'t trust.',
    delay: '160',
  },
  {
    icon: '📞',
    title: 'Missed Calls & Revenue',
    desc: 'Without a clear way to contact you online, customers move on to the next result. Your phone stays quiet.',
    delay: '240',
  },
  {
    icon: '⏰',
    title: 'No Time to Build It',
    desc: 'You run a business. You don\'t have months to learn web design — and you shouldn\'t have to.',
    delay: '320',
  },
  {
    icon: '💸',
    title: 'Agencies Want $5,000+',
    desc: 'Traditional agencies quote $5K–$15K for sites that take months. That\'s not realistic for a local business.',
    delay: '400',
  },
];
---

<section id="services" class="relative py-24 overflow-hidden">
  <!-- Subtle bg -->
  <div class="glow-orb w-[400px] h-[400px] bg-teal-glow top-1/2 -left-32 opacity-25 animate-glow-pulse"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-14" data-animate>
      <span class="section-label">The Problem</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-2 mb-4 leading-tight">
        Your Business Is <span class="text-gradient-orange">Invisible Online</span>
        <br />And It's Costing You Every Day
      </h2>
      <p class="text-kev-text/75 text-lg max-w-2xl mx-auto">
        Right now, someone in Miami is Googling exactly what you offer.
        If you don't have a professional website, they're calling your competitor.
      </p>
    </div>

    <!-- Pain cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {pains.map((pain) => (
        <div
          class="glass-card p-7 group relative overflow-hidden"
          data-animate
          style={`--delay: ${pain.delay}ms`}
        >
          <!-- Hover shine -->
          <div
            class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
            style="background: linear-gradient(135deg, rgba(0,194,203,0.05) 0%, transparent 60%);"
          ></div>
          <div class="text-4xl mb-4">{pain.icon}</div>
          <h3 class="text-white font-bold text-base mb-2">{pain.title}</h3>
          <p class="text-kev-muted text-sm leading-relaxed">{pain.desc}</p>
        </div>
      ))}
    </div>

    <!-- Bridge to solution -->
    <div class="mt-14 text-center" data-animate style="--delay: 400ms">
      <div
        class="inline-block rounded-2xl px-8 py-6 border"
        style="background: rgba(0,194,203,0.06); border-color: rgba(0,194,203,0.2);"
      >
        <p class="text-white text-xl font-bold mb-2">
          The good news? <span class="text-gradient-teal">All of this is fixable.</span>
        </p>
        <p class="text-kev-text/75 text-sm max-w-lg">
          KevDigital builds professional websites specifically for Miami local businesses
          — at a price that makes sense. No agency markup. No fluff.
        </p>
        <a href="#audit" class="inline-flex items-center gap-2 mt-5 btn-orange text-sm py-3 px-7 rounded-full">
          Fix My Online Presence
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
