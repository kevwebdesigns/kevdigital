---
import CountdownTimer from './CountdownTimer.tsx';
interface Props {
  checkoutUrl: string;
}
const { checkoutUrl } = Astro.props;
---

<section class="relative py-24 overflow-hidden" id="offer" style="background: linear-gradient(135deg, #0d0020 0%, #1a0040 30%, #0d0025 60%, #050510 100%);">
  <!-- Space image overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1534796636912-3b19b83433b6?w=1400&q=80&auto=format&fit=crop"
      alt="Galaxy background"
      class="w-full h-full object-cover opacity-15"
      loading="lazy"
    />
  </div>
  <div class="glow-orb w-[500px] h-[500px] bg-purple-glow top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-40"></div>
  <div class="glow-orb w-[300px] h-[300px] bg-blue-glow -top-10 right-10 opacity-30"></div>

  <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div data-animate>
      <!-- Flash sale label -->
      <div class="inline-flex items-center gap-2 bg-red-500/20 border border-red-500/40 rounded-full px-5 py-2 text-sm font-bold text-red-400 mb-5">
        <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
        FLASH SALE — TODAY ONLY
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mb-4">
        This Deal <span class="text-gradient">Expires In</span>
      </h2>
    </div>

    <!-- Countdown -->
    <div class="mb-6" data-animate style="--delay: 80ms">
      <CountdownTimer client:load />
    </div>

    <!-- Scarcity -->
    <div class="inline-flex items-center gap-2 bg-red-500/15 border border-red-500/30 rounded-full px-5 py-2.5 mb-8" data-animate style="--delay: 150ms">
      <span class="w-2.5 h-2.5 bg-red-500 rounded-full animate-pulse-dot flex-shrink-0"></span>
      <span class="text-red-400 text-sm font-bold">⚠️ Only 23 units left in stock — 47 people viewing right now</span>
    </div>

    <!-- Price block -->
    <div class="glass-card p-8 mb-7 text-center" data-animate style="--delay: 200ms" style="border-color: rgba(168,85,247,0.4);">
      <div class="flex items-center justify-center gap-4 mb-3">
        <span class="text-5xl sm:text-6xl font-black text-white">$24.95</span>
        <div class="text-left">
          <span class="text-galaxy-muted line-through text-xl block">$31.19</span>
          <span class="price-badge">SAVE $6.24</span>
        </div>
      </div>
      <p class="text-galaxy-muted text-sm">Free worldwide shipping included</p>

      <!-- Mini stock bar -->
      <div class="mt-4 mb-1">
        <div class="flex justify-between text-xs text-galaxy-muted mb-1.5">
          <span>Availability</span>
          <span class="text-red-400 font-semibold">82% SOLD</span>
        </div>
        <div class="w-full bg-white/10 rounded-full h-2">
          <div class="h-2 rounded-full" style="width: 82%; background: linear-gradient(90deg, #7c3aed, #ef4444);"></div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div data-animate style="--delay: 280ms">
      <a href={checkoutUrl} class="btn-primary text-xl py-5 px-10 w-full sm:w-auto inline-flex mb-3">
        🚀 CLAIM MY 20% DISCOUNT
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <p class="text-galaxy-muted text-sm">🔒 Secure checkout · No subscription · Ships in 24 hours</p>
    </div>

    <!-- Guarantees -->
    <div class="grid grid-cols-3 gap-4 mt-10" data-animate style="--delay: 350ms">
      {[
        { icon: '💰', title: '30-Day Money Back', sub: 'Full refund, no questions.' },
        { icon: '🔐', title: 'Secure Checkout', sub: '256-bit SSL encryption.' },
        { icon: '🚚', title: 'Free Shipping', sub: 'Ships within 24 hours.' },
      ].map((g) => (
        <div class="glass-card p-4 text-center">
          <p class="text-3xl mb-2">{g.icon}</p>
          <p class="text-white text-xs font-bold leading-tight mb-1">{g.title}</p>
          <p class="text-galaxy-muted text-[11px] leading-snug">{g.sub}</p>
        </div>
      ))}
    </div>
  </div>
</section>
