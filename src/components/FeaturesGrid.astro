---
const features = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="4" height="4" rx="1"/><rect x="10" y="3" width="4" height="4" rx="1"/><rect x="17" y="3" width="4" height="4" rx="1"/><rect x="3" y="10" width="4" height="4" rx="1"/><rect x="10" y="10" width="4" height="4" rx="1"/><rect x="17" y="10" width="4" height="4" rx="1"/><rect x="3" y="17" width="4" height="4" rx="1"/><rect x="10" y="17" width="4" height="4" rx="1"/><rect x="17" y="17" width="4" height="4" rx="1"/></svg>`,
    title: '16 Interchangeable Slides',
    desc: 'Moon, Earth, Mars, Jupiter, Saturn, Neptune, galaxies, aurora & more. Switch scenes in seconds.',
    delay: '0',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/></svg>`,
    title: '360° Coverage',
    desc: 'Covers up to 12m² of surface area. Fills your entire ceiling and walls with galaxy visuals.',
    delay: '80',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>`,
    title: 'Eye-Friendly Soft Light',
    desc: 'Gentle low-intensity projection. Safe for kids, perfect for winding down before sleep.',
    delay: '160',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12H3"/><path d="M12 5V3"/><path d="M19 12h2"/><path d="M12 19v2"/><rect x="8" y="8" width="8" height="8" rx="2"/></svg>`,
    title: 'USB Powered',
    desc: 'Works with any USB port — laptop, phone charger, power bank. No batteries ever.',
    delay: '240',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"/><path d="M5 12c0-3.87 3.13-7 7-7s7 3.13 7 7"/><path d="M12 12c0-2.21-1.79-4-4-4"/><path d="M5 12H2"/></svg>`,
    title: 'Flexible Gooseneck Arm',
    desc: '16cm adjustable arm bends to any angle. Clip to bed frame, desk, or shelf easily.',
    delay: '320',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
    title: 'Compact & Portable',
    desc: 'Fits in your pocket. Take it to hotels, sleepovers, or anywhere you want the galaxy vibe.',
    delay: '400',
  },
];
---

<section class="relative py-24 bg-galaxy-deep overflow-hidden">
  <div class="glow-orb w-[400px] h-[400px] bg-blue-glow top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-15"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-8" data-animate>
      <span class="section-label">Features</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-4 mb-4">
        Everything You <span class="text-gradient">Need & More</span>
      </h2>
      <p class="text-galaxy-muted text-lg max-w-xl mx-auto">
        Engineered for maximum atmosphere, minimum effort.
      </p>
    </div>

    <!-- Banner image: product + all 16 slides (AliExpress image 1) -->
    <div class="relative rounded-3xl overflow-hidden mb-10 aspect-[21/9] sm:aspect-[21/7]" data-animate style="--delay: 100ms; border: 1px solid rgba(168,85,247,0.25); box-shadow: 0 0 40px rgba(124,58,237,0.2);">
      <!-- PRODUCT IMAGE: Product with all 16 slides laid out (AliExpress image 1/6 or 2/6) -->
      <!-- Replace src below with the AliExpress product+slides image URL when provided -->
      <img
        src="https://images.unsplash.com/photo-1446776811953-b23d57bd21aa?w=1400&q=85&auto=format&fit=crop"
        alt="Galaxy Moon Projection Lamp with all 16 interchangeable projection slides"
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 flex items-center justify-center" style="background: rgba(5,5,16,0.5);">
        <div class="text-center">
          <p class="text-white font-black text-2xl sm:text-3xl lg:text-4xl mb-2">Galaxy Moon Projection Lamp</p>
          <p class="text-galaxy-stardust text-base sm:text-lg">+ 16 Interchangeable Planet Slides Included</p>
        </div>
      </div>
    </div>

    <!-- Feature cards grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((f, idx) => (
        <>
          <div
            class="glass-card p-8 group hover:border-galaxy-purple/50 transition-all duration-300 hover:-translate-y-1"
            data-animate
            style={`--delay: ${f.delay}ms`}
          >
            <div class="w-12 h-12 rounded-2xl bg-galaxy-purple/20 border border-galaxy-purple/30 flex items-center justify-center mb-5 group-hover:bg-galaxy-purple/30 transition-colors text-galaxy-glow">
              <div class="w-6 h-6" set:html={f.icon} />
            </div>
            <h3 class="text-white font-bold text-lg mb-2">{f.title}</h3>
            <p class="text-galaxy-muted text-sm leading-relaxed">{f.desc}</p>
          </div>

          {/* After "Compact & Portable" (last card, index 5), insert a full-width specs image */}
          {idx === 5 && (
            <div
              class="sm:col-span-2 lg:col-span-3 relative rounded-3xl overflow-hidden aspect-[21/8]"
              data-animate
              style="--delay: 500ms; border: 1px solid rgba(168,85,247,0.2); box-shadow: 0 0 30px rgba(124,58,237,0.15);"
            >
              <!-- PRODUCT IMAGE: Dimensions diagram (AliExpress image 6/6) showing 16cm arm, 280cm projection, 12m² area -->
              <!-- Replace src below with the AliExpress dimensions diagram image URL when provided -->
              <img
                src="https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=1400&q=85&auto=format&fit=crop"
                alt="Galaxy Projection Lamp dimensions: 16cm flexible arm, 280cm max projection distance, 12m² coverage"
                class="w-full h-full object-cover opacity-70"
                loading="lazy"
              />
              <div class="absolute inset-0 flex items-center justify-center" style="background: rgba(5,5,16,0.55);">
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-center px-8">
                  {[
                    { num: '16cm', label: 'Flexible Arm' },
                    { num: '280cm', label: 'Max Projection' },
                    { num: '12m²', label: 'Coverage Area' },
                    { num: '400cm', label: 'Circular Diameter' },
                  ].map((s) => (
                    <div>
                      <p class="text-gradient font-black text-3xl sm:text-4xl">{s.num}</p>
                      <p class="text-galaxy-stardust text-sm mt-1">{s.label}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}
        </>
      ))}
    </div>

  </div>
</section>
