---
interface Props {
  checkoutUrl: string;
}
const { checkoutUrl } = Astro.props;

const benefits = [
  'Projects realistic moons, planets & galaxies onto any surface',
  'Adjustable flexible gooseneck arm bends to any direction',
  'Covers up to 12m² — fills walls AND ceiling',
  'Ultra-compact — fits in your palm, goes anywhere',
  'Simple USB power — plug into any charger or laptop',
  '16 interchangeable slides for endless variety',
];
---

<section class="relative py-24 bg-galaxy-void overflow-hidden">
  <div class="glow-orb w-[400px] h-[400px] bg-purple-glow -bottom-20 -left-20 opacity-35"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: Lifestyle image -->
      <div class="relative" data-animate>
        <!-- Main lifestyle image - woman sleeping under galaxy projection -->
        <div class="relative rounded-3xl overflow-hidden aspect-[4/5]" style="border: 1px solid rgba(168,85,247,0.3); box-shadow: 0 0 60px rgba(124,58,237,0.4);">
          <img
            src="https://images.unsplash.com/photo-1531353826977-0941b4779a1c?w=800&q=85&auto=format&fit=crop&crop=center"
            alt="Cozy bedroom with galaxy projection atmosphere"
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <!-- Purple overlay for brand consistency -->
          <div class="absolute inset-0" style="background: linear-gradient(160deg, rgba(26,5,51,0.4) 0%, rgba(5,5,16,0.2) 50%, rgba(5,5,16,0.7) 100%);"></div>

          <!-- Before / After labels -->
          <div class="absolute top-4 left-4 right-4 flex justify-between z-10">
            <span class="bg-red-500/25 border border-red-500/50 text-red-400 text-xs font-bold px-3 py-1 rounded-full backdrop-blur-sm">BEFORE</span>
            <span class="bg-green-500/25 border border-green-500/50 text-green-400 text-xs font-bold px-3 py-1 rounded-full backdrop-blur-sm">AFTER ✨</span>
          </div>

          <!-- Overlay text on image -->
          <div class="absolute bottom-0 left-0 right-0 p-6 z-10" style="background: linear-gradient(transparent, rgba(5,5,16,0.95));">
            <p class="text-white font-bold text-base">Soft Light Eye Care</p>
            <p class="text-galaxy-stardust/80 text-sm">Immersive bedtime experience · Turn your home into a private starry sky</p>
          </div>
        </div>

        <!-- Floating spec badges -->
        <div class="absolute -right-4 top-1/4 glass-card p-3 text-center hidden sm:block" style="box-shadow: 0 0 20px rgba(124,58,237,0.4);">
          <p class="text-gradient font-black text-xl">12m²</p>
          <p class="text-galaxy-muted text-xs">Coverage Area</p>
        </div>
        <div class="absolute -left-4 bottom-1/3 glass-card p-3 text-center hidden sm:block" style="box-shadow: 0 0 20px rgba(124,58,237,0.4);">
          <p class="text-gradient font-black text-xl">280cm</p>
          <p class="text-galaxy-muted text-xs">Max Range</p>
        </div>
      </div>

      <!-- Right: Copy -->
      <div data-animate style="--delay: 150ms">
        <span class="section-label">The Solution</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-4 mb-5 leading-tight">
          Your Own Personal<br /><span class="text-gradient">Orbit Light</span>
        </h2>
        <p class="text-galaxy-stardust/85 text-lg mb-8 leading-relaxed">
          It casts a <strong class="text-white">soft galaxy glow</strong> against your bedroom wall. Watch the moon drift across the ceiling as you drift off. It feels like staring into space from your pillow — everything slows down when the room becomes the galaxy.
        </p>

        <ul class="space-y-3.5 mb-9">
          {benefits.map((b) => (
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-galaxy-purple/30 border border-galaxy-purple/60 flex items-center justify-center mt-0.5">
                <svg class="w-3 h-3 text-galaxy-glow" viewBox="0 0 12 12" fill="none">
                  <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="text-galaxy-stardust/90 text-base">{b}</span>
            </li>
          ))}
        </ul>

        <a href={checkoutUrl} class="btn-primary">
          BUY IT NOW — $24.95
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <p class="text-galaxy-muted text-sm mt-3">Free shipping · 30-day returns · Secure checkout</p>
      </div>

    </div>
  </div>
</section>
