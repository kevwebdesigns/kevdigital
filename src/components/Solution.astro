---
interface Props {
  checkoutUrl: string;
}
const { checkoutUrl } = Astro.props;

const benefits = [
  'Projects realistic moons, planets & galaxies onto any surface',
  'Adjustable flexible gooseneck arm bends to any angle',
  'Covers up to 12m² of wall and ceiling space',
  'Ultra-compact — fits in your palm, goes anywhere',
  'Simple USB power — plug into any phone charger or laptop',
  '16 interchangeable slides for endless variety',
];
---

<section class="relative py-24 bg-galaxy-void overflow-hidden">
  <div class="glow-orb w-[400px] h-[400px] bg-purple-glow -bottom-20 -left-20 opacity-40"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: Visual -->
      <div class="relative" data-animate>
        <div class="relative rounded-3xl overflow-hidden aspect-[4/5]" style="background: radial-gradient(ellipse at 20% 20%, #1a0533 0%, #050510 60%); border: 1px solid rgba(168,85,247,0.2); box-shadow: 0 0 60px rgba(124,58,237,0.3);">
          <div class="absolute inset-0 stars-bg opacity-60"></div>

          <!-- Before / After labels -->
          <div class="absolute top-4 left-4 right-4 flex justify-between z-10">
            <span class="bg-red-500/20 border border-red-500/40 text-red-400 text-xs font-bold px-3 py-1 rounded-full">BEFORE</span>
            <span class="bg-green-500/20 border border-green-500/40 text-green-400 text-xs font-bold px-3 py-1 rounded-full">AFTER ✨</span>
          </div>

          <!-- Split room visual -->
          <div class="absolute inset-0 flex">
            <!-- Before half: plain dark room -->
            <div class="w-1/2 h-full flex flex-col items-center justify-center" style="background: #111118;">
              <div class="w-16 h-16 rounded-full bg-gray-700/50 border border-gray-600/30 mb-3 flex items-center justify-center text-2xl">😐</div>
              <p class="text-gray-500 text-xs text-center px-3">Plain boring room</p>
            </div>
            <!-- Divider -->
            <div class="absolute left-1/2 top-0 bottom-0 w-px bg-galaxy-glow/60" style="box-shadow: 0 0 8px rgba(168,85,247,0.8);"></div>
            <!-- After half: galaxy projection -->
            <div class="w-1/2 h-full flex flex-col items-center justify-center relative overflow-hidden" style="background: radial-gradient(ellipse at 50% 30%, #2d0b4e 0%, #0a0015 70%);">
              <div class="absolute inset-0 stars-bg opacity-90"></div>
              <!-- Galaxy projection circle -->
              <div class="relative z-10 w-28 h-28 rounded-full mb-3" style="background: radial-gradient(circle at 35% 35%, #c0a0e0, #5020a0, #1a0040); box-shadow: 0 0 40px rgba(168,85,247,0.8), 0 0 80px rgba(168,85,247,0.4);"></div>
              <!-- Projection rays -->
              <div class="absolute top-1/2 left-1/4 w-20 h-32 -translate-y-1/2 -translate-x-1/2 opacity-20" style="background: conic-gradient(from 180deg at 100% 50%, rgba(168,85,247,0.8), transparent 60deg);"></div>
              <p class="relative z-10 text-galaxy-stardust text-xs text-center px-3">Galaxy projection ✨</p>
            </div>
          </div>

          <!-- Bottom overlay text -->
          <div class="absolute bottom-0 left-0 right-0 p-5 z-10" style="background: linear-gradient(transparent, rgba(5,5,16,0.9));">
            <p class="text-white font-bold text-sm">Soft Light Eye Care</p>
            <p class="text-galaxy-muted text-xs">Immersive bedtime experience</p>
          </div>
        </div>

        <!-- Floating specs badge -->
        <div class="absolute -right-4 top-1/3 glass-card p-3 text-xs text-center hidden sm:block" style="box-shadow: 0 0 20px rgba(124,58,237,0.3);">
          <p class="text-galaxy-glow font-bold text-base">12m²</p>
          <p class="text-galaxy-muted">Coverage</p>
        </div>
        <div class="absolute -left-4 bottom-1/4 glass-card p-3 text-xs text-center hidden sm:block" style="box-shadow: 0 0 20px rgba(124,58,237,0.3);">
          <p class="text-galaxy-glow font-bold text-base">280cm</p>
          <p class="text-galaxy-muted">Max Range</p>
        </div>
      </div>

      <!-- Right: Copy -->
      <div data-animate style="--delay: 150ms">
        <span class="section-label">The Solution</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-4 mb-4 leading-tight">
          Your Own Personal<br /><span class="text-gradient">Orbit Light</span>
        </h2>
        <p class="text-galaxy-stardust/80 text-lg mb-8 leading-relaxed">
          It casts a <strong class="text-white">soft galaxy glow</strong> against your bedroom wall. Watch the moon drift across the ceiling as you drift off. It feels like staring into space from your pillow. Everything slows down when the room turns into the galaxy.
        </p>

        <ul class="space-y-4 mb-10">
          {benefits.map((b) => (
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-galaxy-purple/30 border border-galaxy-purple/60 flex items-center justify-center mt-0.5">
                <svg class="w-3 h-3 text-galaxy-glow" viewBox="0 0 12 12" fill="none">
                  <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="text-galaxy-stardust/90 text-base">{b}</span>
            </li>
          ))}
        </ul>

        <a href={checkoutUrl} class="btn-primary">
          BUY IT NOW
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <p class="text-galaxy-muted text-sm mt-3">Bring the night sky home today</p>
      </div>

    </div>
  </div>
</section>
