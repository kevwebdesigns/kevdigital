---
interface Props {
  checkoutUrl: string;
}
const { checkoutUrl } = Astro.props;
---

<section class="relative py-28 overflow-hidden">
  <!-- Real galaxy image background -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1446776811953-b23d57bd21aa?w=1600&q=85&auto=format&fit=crop"
      alt="Galaxy universe background"
      class="w-full h-full object-cover object-center"
      loading="lazy"
    />
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(5,5,16,0.85) 0%, rgba(10,0,30,0.80) 50%, rgba(5,5,16,0.90) 100%);"></div>
  </div>

  <!-- Glow orb -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full pointer-events-none animate-glow-pulse" style="background: radial-gradient(circle, rgba(124,58,237,0.3) 0%, transparent 70%);"></div>

  <!-- Floating planets -->
  <div class="absolute top-12 left-8 w-14 h-14 rounded-full animate-float hidden sm:block" style="background: radial-gradient(circle at 35% 35%, #d4d0c8, #808078, #504840); box-shadow: 0 0 24px rgba(168,85,247,0.5); animation-delay: 0s;"></div>
  <div class="absolute bottom-16 right-10 w-10 h-10 rounded-full animate-float hidden sm:block" style="background: radial-gradient(circle at 35% 35%, #93c5fd, #1e40af); box-shadow: 0 0 18px rgba(59,130,246,0.5); animation-delay: 2s;"></div>
  <div class="absolute top-1/3 right-16 w-7 h-7 rounded-full animate-float hidden lg:block" style="background: radial-gradient(circle at 35% 35%, #f87171, #991b1b); box-shadow: 0 0 14px rgba(248,113,113,0.5); animation-delay: 1s;"></div>
  <div class="absolute bottom-1/3 left-16 w-5 h-5 rounded-full animate-float hidden lg:block" style="background: radial-gradient(circle at 35% 35%, #fcd34d, #92400e); box-shadow: 0 0 10px rgba(252,211,77,0.4); animation-delay: 3s;"></div>

  <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div data-animate>
      <div class="text-6xl mb-6">🌌</div>

      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mb-5 leading-tight">
        Bring The Galaxy<br />
        <span class="text-gradient">Home Tonight</span>
      </h2>

      <p class="text-galaxy-stardust/85 text-xl mb-4 max-w-xl mx-auto leading-relaxed">
        Your dream room is one click away. Join 10,000+ people who transformed their space — and finally have a room that actually feels like theirs.
      </p>

      <!-- Last urgency before checkout -->
      <div class="inline-flex items-center gap-2 bg-red-500/15 border border-red-500/30 rounded-full px-4 py-2 mb-8 text-sm">
        <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
        <span class="text-red-400 font-semibold">Only 23 left · 20% discount expires soon</span>
      </div>

      <!-- Big CTA -->
      <div class="mb-5">
        <a href={checkoutUrl} class="btn-primary text-2xl py-6 px-12 inline-flex">
          Get Yours Before They Sell Out
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Price reminder -->
      <div class="flex items-center justify-center gap-3 mb-8">
        <span class="text-3xl font-black text-white">$24.95</span>
        <span class="text-galaxy-muted line-through text-lg">$31.19</span>
        <span class="price-badge">20% OFF</span>
      </div>

      <!-- Trust row -->
      <div class="flex items-center justify-center gap-6 flex-wrap mb-10">
        {[
          { icon: '🔒', text: 'Secure checkout' },
          { icon: '🚚', text: 'Free shipping' },
          { icon: '↩️', text: '30-day returns' },
          { icon: '⭐', text: 'Rated 4.9/5' },
        ].map((t) => (
          <div class="flex items-center gap-1.5 text-galaxy-muted text-sm">
            <span>{t.icon}</span><span>{t.text}</span>
          </div>
        ))}
      </div>

      <!-- Payment methods -->
      <div class="flex items-center justify-center gap-2 flex-wrap mb-10">
        {['VISA', 'MASTERCARD', 'PAYPAL', 'AMEX', 'APPLE PAY', 'SHOP PAY'].map((p) => (
          <span class="bg-white/10 border border-white/15 rounded px-2 py-1 text-white text-[9px] font-bold">{p}</span>
        ))}
      </div>

      <div class="gradient-divider mb-8"></div>

      <p class="text-galaxy-muted/50 text-xs">
        © 2025 Galaxy Moon Lamp. All rights reserved. · <a href="#" class="hover:text-galaxy-muted transition-colors">Privacy Policy</a> · <a href="#" class="hover:text-galaxy-muted transition-colors">Terms of Service</a>
      </p>
    </div>
  </div>
</section>
