---
const problems = [
  {
    emoji: '🌑',
    title: 'Your room feels boring and lifeless',
    body: 'Plain walls, generic LED strips, nothing that actually feels like *you*. Every night feels the same.',
    delay: '0',
  },
  {
    emoji: '😩',
    title: "You can't unwind before bed",
    body: "Bright harsh lighting keeps your mind racing. You scroll for hours because there's nothing calming to look at.",
    delay: '100',
  },
  {
    emoji: '💡',
    title: 'LED strips feel basic and overdone',
    body: 'Everyone has the same RGB setup. They wash out, they flicker, and they never create a real atmosphere.',
    delay: '200',
  },
  {
    emoji: '😴',
    title: 'You want a cozy aesthetic space',
    body: 'You see those dreamy TikTok rooms and think "why does my space never look like that?"',
    delay: '300',
  },
];
---

<section class="relative py-24 bg-galaxy-deep overflow-hidden">
  <div class="glow-orb w-[350px] h-[350px] bg-purple-glow top-0 right-0 opacity-30"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-animate>
      <span class="section-label">Sound Familiar?</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-4 mb-4">
        Your Room Deserves <span class="text-gradient">Better</span>
      </h2>
      <p class="text-galaxy-muted text-lg max-w-xl mx-auto">
        Most people settle for boring setups because they don't know a better option exists.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {problems.map((p) => (
        <div
          class="glass-card p-7 text-center group hover:border-galaxy-purple/40 transition-all duration-300"
          data-animate
          style={`--delay: ${p.delay}ms`}
        >
          <div class="text-4xl mb-4">{p.emoji}</div>
          <h3 class="text-white font-bold text-lg mb-3 leading-tight">{p.title}</h3>
          <p class="text-galaxy-muted text-sm leading-relaxed">{p.body}</p>
        </div>
      ))}
    </div>

    <!-- Hook line -->
    <div class="text-center mt-14" data-animate style="--delay: 400ms">
      <p class="text-xl sm:text-2xl text-galaxy-stardust font-semibold">
        You deserve a space that actually feels like <span class="text-gradient italic">yours.</span>
      </p>
    </div>
  </div>
</section>
