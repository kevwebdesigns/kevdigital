---
interface Props {
  checkoutUrl: string;
}
const { checkoutUrl } = Astro.props;

const planetSlides = [
  { color: '#d4d0c8,#908880', name: 'Moon', emoji: '🌕' },
  { color: '#c87040,#6b3018', name: 'Mars', emoji: '🔴' },
  { color: '#8060c0,#301860', name: 'Galaxy', emoji: '🌌' },
  { color: '#4890e0,#1830a0', name: 'Earth', emoji: '🌍' },
  { color: '#d8a030,#806010', name: 'Jupiter', emoji: '🪐' },
  { color: '#80c8e8,#2060a0', name: 'Neptune', emoji: '💙' },
  { color: '#e06030,#902010', name: 'Mars 2', emoji: '🔸' },
  { color: '#208040,#104020', name: 'Earth 2', emoji: '🌿' },
  { color: '#404090,#101040', name: 'Saturn', emoji: '🪐' },
  { color: '#1a1a30,#050510', name: 'Eclipse', emoji: '⚫' },
  { color: '#302060,#100820', name: 'Space', emoji: '✨' },
  { color: '#1020c0,#050840', name: 'Neptune 2', emoji: '💫' },
  { color: '#1c2060,#080c30', name: 'Galaxy 2', emoji: '🌠' },
  { color: '#006840,#002818', name: 'Aurora', emoji: '🟢' },
  { color: '#500890,#200040', name: 'Nebula', emoji: '💜' },
  { color: '#304848,#101820', name: 'Deep Space', emoji: '🌑' },
];

const galleryImages = [
  {
    src: 'https://images.unsplash.com/photo-1534796636912-3b19b83433b6?w=800&q=85&auto=format&fit=crop',
    alt: 'Galaxy projection on bedroom ceiling',
    label: 'Ceiling Projection Effect',
  },
  {
    src: 'https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=800&q=85&auto=format&fit=crop',
    alt: 'Milky way galaxy projection',
    label: 'Galaxy Slide',
  },
  {
    src: 'https://images.unsplash.com/photo-1446776811953-b23d57bd21aa?w=800&q=85&auto=format&fit=crop',
    alt: 'Purple galaxy nebula projection',
    label: 'Nebula Projection',
  },
  {
    src: 'https://images.unsplash.com/photo-1419242902214-272b3f66ee7a?w=800&q=85&auto=format&fit=crop',
    alt: 'Star field night sky projection',
    label: 'Star Field',
  },
];
---

<section class="relative py-24 bg-galaxy-deep overflow-hidden" id="product">
  <div class="glow-orb w-[450px] h-[450px] bg-purple-glow top-0 left-0 opacity-20"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14" data-animate>
      <span class="section-label">Product Showcase</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-4 mb-4">
        <span class="text-gradient">Galaxy Moon</span> Projection Lamp
      </h2>
      <p class="text-galaxy-muted text-lg max-w-xl mx-auto">Real projection effects. Real atmosphere. Real results.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

      <!-- Left: Image gallery -->
      <div data-animate>
        <!-- Main image -->
        <div class="relative rounded-3xl overflow-hidden aspect-square mb-4 group cursor-pointer" style="border: 1px solid rgba(168,85,247,0.3); box-shadow: 0 0 40px rgba(124,58,237,0.3);" id="main-product-img">
          <img
            id="main-img-el"
            src={galleryImages[0].src}
            alt={galleryImages[0].alt}
            class="w-full h-full object-cover transition-all duration-500"
            loading="lazy"
          />
          <div class="absolute inset-0" style="background: linear-gradient(160deg, transparent 60%, rgba(5,5,16,0.8) 100%);"></div>

          <!-- Image label -->
          <div id="main-img-label" class="absolute bottom-4 left-4 bg-black/60 backdrop-blur-sm border border-white/20 text-white text-sm font-semibold px-4 py-2 rounded-full">
            {galleryImages[0].label}
          </div>

          <!-- 30-day badge -->
          <div class="absolute top-4 right-4 w-16 h-16 rounded-full flex flex-col items-center justify-center text-center backdrop-blur-sm" style="background: rgba(124,58,237,0.6); border: 1px solid rgba(168,85,247,0.5); box-shadow: 0 0 16px rgba(124,58,237,0.5);">
            <p class="text-white font-black text-xl leading-none">30</p>
            <p class="text-galaxy-stardust text-[9px] leading-tight font-semibold">DAY<br/>GUARANTEE</p>
          </div>
        </div>

        <!-- Thumbnail gallery -->
        <div class="grid grid-cols-4 gap-3 mb-5">
          {galleryImages.map((img, i) => (
            <button
              class="thumbnail-btn rounded-2xl overflow-hidden aspect-square border-2 transition-all duration-200 hover:scale-105"
              style={`border-color: ${i === 0 ? 'rgba(168,85,247,0.8)' : 'rgba(255,255,255,0.1)'};`}
              data-src={img.src}
              data-label={img.label}
              data-idx={i}
            >
              <img src={img.src} alt={img.alt} class="w-full h-full object-cover" loading="lazy" />
            </button>
          ))}
        </div>

        <!-- Planet slides visual grid -->
        <div class="glass-card p-4">
          <p class="text-galaxy-muted text-xs mb-3 text-center font-semibold uppercase tracking-wider">16 Interchangeable Projection Slides Included</p>
          <div class="planet-grid">
            {planetSlides.map((p) => (
              <div
                class="aspect-square rounded-lg border border-white/10 hover:border-galaxy-glow/60 transition-all hover:scale-105 cursor-pointer flex items-center justify-center text-base"
                style={`background: radial-gradient(circle at 35% 35%, ${p.color.split(',')[0]}cc, ${p.color.split(',')[1]}88);`}
                title={p.name}
              >
                {p.emoji}
              </div>
            ))}
          </div>
          <p class="text-center text-galaxy-muted text-xs mt-3">Moon · Mars · Earth · Jupiter · Saturn · Neptune · Galaxy · Aurora + more</p>
        </div>
      </div>

      <!-- Right: Product details (sticky on desktop) -->
      <div data-animate style="--delay: 100ms" class="lg:sticky lg:top-8">
        <!-- Rating -->
        <div class="flex items-center gap-2 mb-3">
          <div class="flex gap-0.5">{[1,2,3,4,5].map(() => <span class="text-galaxy-gold text-lg">★</span>)}</div>
          <span class="text-white font-bold">4.9/5</span>
          <span class="text-galaxy-muted text-sm">(1,402 reviews)</span>
        </div>

        <h3 class="text-white font-black text-2xl sm:text-3xl mb-2 leading-tight">
          Galaxy Moon Projection Lamp
        </h3>
        <div class="inline-flex items-center gap-2 bg-galaxy-purple/20 border border-galaxy-purple/30 rounded-full px-3 py-1 text-sm text-galaxy-stardust mb-4">
          <span class="w-2 h-2 bg-galaxy-glow rounded-full animate-pulse"></span>
          Unwind in soft light · Viral bedroom essential
        </div>

        <p class="text-galaxy-muted text-sm mb-5">Drift into a restful sleep with gentle projections on your ceiling. Projects realistic moons, planets & galaxies onto any wall or ceiling surface.</p>

        <!-- Price block -->
        <div class="glass-card p-5 mb-5">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-4xl font-black text-white">$24.95</span>
            <div>
              <span class="text-galaxy-muted line-through text-lg block">$31.19</span>
              <span class="price-badge">SAVE 20%</span>
            </div>
          </div>
          <!-- Stock indicator -->
          <div class="flex items-center gap-2 mb-3">
            <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse-dot"></span>
            <span class="text-red-400 text-sm font-semibold">Only 23 units left in stock!</span>
          </div>
          <!-- Mini stock bar -->
          <div class="w-full bg-white/10 rounded-full h-1.5 mb-1">
            <div class="h-1.5 rounded-full" style="width: 82%; background: linear-gradient(90deg, #7c3aed, #ef4444);"></div>
          </div>
          <p class="text-galaxy-muted text-xs">82% sold out — selling fast</p>
        </div>

        <!-- Benefits -->
        <ul class="space-y-2.5 mb-6">
          {[
            'Projects moons, planets & galaxies on walls & ceiling',
            'Max projection range 280cm · Coverage area 12m²',
            '16 interchangeable slides — swap in seconds',
            'USB powered · Works with any charger or power bank',
            'Flexible 16cm gooseneck arm adjusts to any angle',
          ].map((b) => (
            <li class="flex items-center gap-2.5 text-galaxy-stardust text-sm">
              <svg class="w-4 h-4 text-galaxy-glow flex-shrink-0" viewBox="0 0 16 16" fill="none">
                <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
                <path d="M5 8l2.5 2.5L11 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {b}
            </li>
          ))}
        </ul>

        <!-- CTA -->
        <a href={checkoutUrl} class="btn-primary w-full text-center text-xl py-5 mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          ADD TO CART — $24.95
        </a>

        <!-- Secondary CTA text -->
        <p class="text-center text-galaxy-muted text-xs mb-5">🔒 Secure checkout · Ships in 24hrs · 30-day money back</p>

        <!-- Payment methods -->
        <div class="flex items-center justify-center gap-2 flex-wrap mb-5">
          {['VISA', 'MASTERCARD', 'PAYPAL', 'AMEX', 'APPLE PAY', 'SHOP PAY'].map((p) => (
            <span class="bg-white/10 border border-white/20 rounded px-2 py-1 text-white text-[9px] font-bold tracking-wide">{p}</span>
          ))}
        </div>

        <!-- Trust badges -->
        <div class="grid grid-cols-3 gap-3">
          {[
            { icon: '💰', title: '30-Day Money Back', sub: 'No questions asked' },
            { icon: '🚚', title: 'Free Shipping', sub: 'Worldwide delivery' },
            { icon: '🔒', title: 'Secure Payment', sub: '256-bit SSL' },
          ].map((b) => (
            <div class="glass-card p-3 text-center">
              <p class="text-2xl mb-1">{b.icon}</p>
              <p class="text-white text-xs font-bold leading-tight">{b.title}</p>
              <p class="text-galaxy-muted text-[10px]">{b.sub}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.thumbnail-btn');
  const mainImg = document.getElementById('main-img-el') as HTMLImageElement | null;
  const mainLabel = document.getElementById('main-img-label') as HTMLElement | null;

  thumbs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.src;
      const label = btn.dataset.label;
      if (mainImg && src) mainImg.src = src;
      if (mainLabel && label) mainLabel.textContent = label;
      thumbs.forEach((b) => b.style.setProperty('border-color', 'rgba(255,255,255,0.1)'));
      btn.style.setProperty('border-color', 'rgba(168,85,247,0.8)');
    });
  });
</script>
