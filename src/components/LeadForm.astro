---
---

<section
  id="audit"
  class="relative py-24 overflow-hidden"
  style="background: linear-gradient(180deg, #050D18 0%, #071524 50%, #050D18 100%);"
>
  <!-- Glow -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at 50% 0%, rgba(0,194,203,0.1) 0%, transparent 60%);"
  ></div>
  <div class="glow-orb w-[400px] h-[400px] bg-orange-glow bottom-0 right-0 opacity-20 animate-glow-pulse" style="animation-delay: 1.5s;"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

      <!-- Left: Copy -->
      <div data-animate>
        <span class="section-label">Free Website Audit</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-2 mb-5 leading-tight">
          Get Your Free<br />
          <span class="text-gradient-teal">Website Audit</span><br />
          Today
        </h2>
        <p class="text-kev-text/80 text-lg mb-8 leading-relaxed">
          I'll personally review your current web presence and send you a
          <strong class="text-white">free, custom video audit</strong> showing exactly what's hurting your business online
          — and how to fix it. No sales pitch. No strings attached.
        </p>

        <!-- What you get -->
        <div class="space-y-4 mb-10">
          {[
            { icon: '🎥', title: 'Personalized Video Review', desc: 'A 5-minute screen recording of your current website with honest feedback.' },
            { icon: '🔍', title: 'Google Presence Check', desc: 'We check if your business shows up on Google Maps and Search.' },
            { icon: '📱', title: 'Mobile Score', desc: 'See how your site performs on phones — where most customers find you.' },
            { icon: '🚀', title: 'Action Plan', desc: 'Specific recommendations to improve your site and get more customers.' },
          ].map((item) => (
            <div class="flex items-start gap-4">
              <div
                class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 text-xl"
                style="background: rgba(0,194,203,0.1); border: 1px solid rgba(0,194,203,0.2);"
              >
                {item.icon}
              </div>
              <div>
                <p class="text-white font-semibold text-sm">{item.title}</p>
                <p class="text-kev-muted text-sm">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Direct contact -->
        <div
          class="rounded-2xl p-5 border"
          style="background: rgba(13,30,53,0.7); border-color: #162840;"
        >
          <p class="text-kev-muted text-xs font-semibold uppercase tracking-wider mb-3">Or reach out directly</p>
          <div class="space-y-2.5">
            <a
              href="tel:+17868004865"
              class="flex items-center gap-3 text-white hover:text-kev-teal transition-colors group"
            >
              <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(0,194,203,0.12);">
                <svg class="w-4 h-4 text-kev-teal" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="text-sm font-medium">(786) 800-4865</span>
            </a>
            <a
              href="mailto:kevwebdesigns1@gmail.com"
              class="flex items-center gap-3 text-white hover:text-kev-teal transition-colors"
            >
              <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(0,194,203,0.12);">
                <svg class="w-4 h-4 text-kev-teal" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <span class="text-sm font-medium">kevwebdesigns1@gmail.com</span>
            </a>
            <div class="flex items-center gap-3">
              <a
                href="https://www.tiktok.com/@kevwebdesigns"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-white hover:text-kev-teal transition-colors text-sm font-medium"
              >
                <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 text-kev-teal" style="background: rgba(0,194,203,0.12);">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/></svg>
                </div>
                @kevwebdesigns
              </a>
              <a
                href="https://www.instagram.com/kevwebdesigns1"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-white hover:text-kev-orange transition-colors text-sm font-medium"
              >
                <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 text-kev-orange" style="background: rgba(255,107,53,0.1);">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                    <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                  </svg>
                </div>
                @kevwebdesigns1
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div data-animate style="--delay: 120ms">
        <div
          class="rounded-2xl p-8 border relative overflow-hidden"
          style="background: rgba(13,30,53,0.85); border-color: rgba(0,194,203,0.25); box-shadow: 0 0 40px rgba(0,194,203,0.08);"
        >
          <!-- Glow top accent -->
          <div
            class="absolute top-0 left-0 right-0 h-[2px] rounded-t-2xl"
            style="background: linear-gradient(90deg, transparent, #00C2CB, transparent);"
          ></div>

          <h3 class="text-white font-black text-2xl mb-2">Get Your Free Audit</h3>
          <p class="text-kev-muted text-sm mb-7">Takes 2 minutes. Results in 24 hours.</p>

          <form
            name="website-audit"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="space-y-4"
            id="audit-form"
          >
            <!-- Netlify honeypot -->
            <input type="hidden" name="form-name" value="website-audit" />
            <p style="display:none;">
              <label>Don't fill this out: <input name="bot-field" /></label>
            </p>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-kev-muted text-xs font-semibold uppercase tracking-wider mb-1.5">
                  Your Name *
                </label>
                <input
                  type="text"
                  name="name"
                  required
                  placeholder="John Smith"
                  class="form-input"
                />
              </div>
              <div>
                <label class="block text-kev-muted text-xs font-semibold uppercase tracking-wider mb-1.5">
                  Phone *
                </label>
                <input
                  type="tel"
                  name="phone"
                  required
                  placeholder="(305) 555-0000"
                  class="form-input"
                />
              </div>
            </div>

            <div>
              <label class="block text-kev-muted text-xs font-semibold uppercase tracking-wider mb-1.5">
                Business Name *
              </label>
              <input
                type="text"
                name="business"
                required
                placeholder="Miami Plumbing Co."
                class="form-input"
              />
            </div>

            <div>
              <label class="block text-kev-muted text-xs font-semibold uppercase tracking-wider mb-1.5">
                Email Address *
              </label>
              <input
                type="email"
                name="email"
                required
                placeholder="you@yourbusiness.com"
                class="form-input"
              />
            </div>

            <div>
              <label class="block text-kev-muted text-xs font-semibold uppercase tracking-wider mb-1.5">
                Current Website (if any)
              </label>
              <input
                type="url"
                name="website"
                placeholder="https://yourbusiness.com"
                class="form-input"
              />
            </div>

            <div>
              <label class="block text-kev-muted text-xs font-semibold uppercase tracking-wider mb-1.5">
                What's Your Biggest Challenge Online?
              </label>
              <select name="challenge" class="form-input" style="color: #CBD5E1;">
                <option value="" disabled selected style="color: #64748B; background: #0D1E35;">Select one...</option>
                <option value="no-website" style="background: #0D1E35;">I don't have a website yet</option>
                <option value="old-website" style="background: #0D1E35;">My current site is outdated</option>
                <option value="not-found" style="background: #0D1E35;">Customers can't find me on Google</option>
                <option value="not-converting" style="background: #0D1E35;">My site doesn't generate leads</option>
                <option value="mobile" style="background: #0D1E35;">My site looks bad on phones</option>
                <option value="other" style="background: #0D1E35;">Other</option>
              </select>
            </div>

            <button
              type="submit"
              class="btn-orange w-full text-base py-4 rounded-full mt-2"
            >
              Send Me My Free Audit
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <p class="text-kev-muted text-xs text-center">
              🔒 No spam. No pitch. Just honest feedback — within 24 hours.
            </p>
          </form>

          <!-- Success message (hidden by default) -->
          <div id="form-success" style="display:none;" class="text-center py-8">
            <div class="text-5xl mb-4">🎉</div>
            <h4 class="text-white font-black text-xl mb-2">Audit Request Received!</h4>
            <p class="text-kev-text/75 text-sm">
              Kev will personally review your business online and send you a custom video audit within 24 hours.
              Check your email (and spam folder just in case)!
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('audit-form') as HTMLFormElement | null;
    const success = document.getElementById('form-success');
    if (form && success) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        try {
          await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(data as any).toString(),
          });
          form.style.display = 'none';
          success.style.display = 'block';
        } catch {
          form.submit();
        }
      });
    }
  </script>
</section>
