---
const items = [
  { icon: '🚀', text: 'Free Shipping Worldwide' },
  { icon: '🔒', text: 'Secure Checkout' },
  { icon: '↩️', text: '30-Day Money Back' },
  { icon: '⭐', text: 'Rated 4.9 / 5 Stars' },
  { icon: '📦', text: '10,000+ Sold' },
  { icon: '⚡', text: 'Ships in 24 Hours' },
  { icon: '🌙', text: '16 Projection Slides' },
  { icon: '🔌', text: 'USB Powered' },
];
const doubled = [...items, ...items];
---

<div class="bg-galaxy-purple/20 border-y border-galaxy-purple/30 py-3 overflow-hidden">
  <div class="flex animate-marquee whitespace-nowrap gap-8">
    {doubled.map((item) => (
      <span class="inline-flex items-center gap-2 text-sm font-medium text-galaxy-stardust px-2">
        <span>{item.icon}</span>
        <span>{item.text}</span>
        <span class="text-galaxy-glow/50 ml-4">•</span>
      </span>
    ))}
  </div>
</div>
