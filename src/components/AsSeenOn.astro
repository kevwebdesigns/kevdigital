---
// "As Seen On" viral social proof bar — huge conversion trust signal
---

<section class="py-10 bg-galaxy-void border-y border-white/5">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-center text-galaxy-muted text-xs uppercase tracking-widest font-semibold mb-7">
      As Featured On
    </p>
    <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 lg:gap-16">
      <!-- TikTok -->
      <div class="flex items-center gap-2 opacity-60 hover:opacity-100 transition-opacity">
        <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.2 8.2 0 004.79 1.53V6.76a4.85 4.85 0 01-1.02-.07z"/>
        </svg>
        <span class="text-white font-bold text-lg tracking-tight">TikTok</span>
      </div>
      <!-- Instagram -->
      <div class="flex items-center gap-2 opacity-60 hover:opacity-100 transition-opacity">
        <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
        <span class="text-white font-bold text-lg tracking-tight">Instagram</span>
      </div>
      <!-- Pinterest -->
      <div class="flex items-center gap-2 opacity-60 hover:opacity-100 transition-opacity">
        <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
        </svg>
        <span class="text-white font-bold text-lg tracking-tight">Pinterest</span>
      </div>
      <!-- YouTube -->
      <div class="flex items-center gap-2 opacity-60 hover:opacity-100 transition-opacity">
        <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        <span class="text-white font-bold text-lg tracking-tight">YouTube</span>
      </div>
      <!-- BuzzFeed style -->
      <div class="flex items-center gap-2 opacity-60 hover:opacity-100 transition-opacity">
        <span class="text-white font-black text-xl tracking-tighter">BUZZFEED</span>
      </div>
    </div>

    <!-- Viral stats bar -->
    <div class="flex flex-wrap justify-center gap-6 sm:gap-10 mt-10 pt-8 border-t border-white/8">
      {[
        { num: '10,000+', label: 'Happy Customers' },
        { num: '4.9★', label: 'Average Rating' },
        { num: '2.4M+', label: 'TikTok Views' },
        { num: '30-Day', label: 'Money Back' },
      ].map((s) => (
        <div class="text-center">
          <p class="text-2xl font-black text-gradient">{s.num}</p>
          <p class="text-galaxy-muted text-xs mt-1">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
