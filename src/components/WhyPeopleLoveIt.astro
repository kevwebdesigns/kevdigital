---
const reasons = [
  {
    emoji: '💎',
    title: 'Makes Bedrooms Feel Expensive',
    desc: "A simple $25 upgrade that transforms any plain bedroom into a space that looks like it cost thousands to design. Your guests will ask where you got it.",
    tag: 'Aesthetic',
    delay: '0',
  },
  {
    emoji: '🌙',
    title: 'Relaxing Night Atmosphere',
    desc: 'The slow, gentle projection naturally calms your nervous system. Doctors say visual relaxation cues before bed cut sleep onset time by up to 47%.',
    tag: 'Sleep Better',
    delay: '100',
  },
  {
    emoji: '🎬',
    title: 'Perfect for TikTok Content',
    desc: "Every video you shoot in your room instantly becomes cinematic. Galaxy backdrop, zero effort. This is literally what viral 'room aesthetic' TikToks are built on.",
    tag: 'Content Creators',
    delay: '200',
  },
  {
    emoji: '❤️',
    title: 'Romantic Vibe for Couples',
    desc: 'Movie nights under a galaxy projection. Slow dancing under a full moon on your ceiling. Turn any evening into something unforgettable with the flip of a slide.',
    tag: 'Couples',
    delay: '300',
  },
  {
    emoji: '👶',
    title: 'Kids Absolutely Love It',
    desc: "Bedtime battles disappear when kids can't wait to see which planet is on their ceiling tonight. A calming night light that actually gets them excited about sleep.",
    tag: 'Parents',
    delay: '400',
  },
  {
    emoji: '🎁',
    title: 'The Gift They Actually Use',
    desc: "Not another candle. Not another generic gift card. This is the gift that comes out every single night. Rated the #1 most-used gift by our customers.",
    tag: 'Gift Giving',
    delay: '500',
  },
];
---

<section class="relative py-24 bg-galaxy-void overflow-hidden">
  <div class="glow-orb w-[500px] h-[500px] bg-purple-glow top-0 right-0 opacity-25"></div>
  <div class="glow-orb w-[400px] h-[400px] bg-blue-glow bottom-0 left-0 opacity-20"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-animate>
      <span class="section-label">Why People Love It</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-4 mb-4">
        More Than Just A Light.<br /><span class="text-gradient">It's A Feeling.</span>
      </h2>
      <p class="text-galaxy-muted text-lg max-w-xl mx-auto">
        Over 10,000 customers have transformed their spaces. Here's why they can't stop talking about it.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reasons.map((r) => (
        <div
          class="relative glass-card p-8 hover:border-galaxy-purple/40 transition-all duration-300 hover:-translate-y-1 group overflow-hidden"
          data-animate
          style={`--delay: ${r.delay}ms`}
        >
          <!-- Subtle gradient bg on hover -->
          <div class="absolute inset-0 bg-card-gradient opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"></div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-5">
              <span class="text-4xl">{r.emoji}</span>
              <span class="text-xs font-semibold text-galaxy-glow bg-galaxy-glow/10 border border-galaxy-glow/20 px-3 py-1 rounded-full">{r.tag}</span>
            </div>
            <h3 class="text-white font-bold text-xl mb-3 leading-tight">{r.title}</h3>
            <p class="text-galaxy-muted text-sm leading-relaxed">{r.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
