---
const reviews = [
  {
    name: 'Carlos M.',
    business: 'Miami Auto Repair',
    text: 'Kev built our website in less than a week. Professional, fast, and the phone started ringing almost immediately. Best $399 I ever spent for the business.',
    stars: 5,
    delay: '0',
    initial: 'C',
    color: '#FF6B35',
  },
  {
    name: 'Maria L.',
    business: 'Coral Gables Hair Salon',
    text: 'We had a website that looked like it was from 2010. Kev redesigned everything — it\'s modern, it loads fast, and customers compliment it all the time now.',
    stars: 5,
    delay: '100',
    initial: 'M',
    color: '#00C2CB',
  },
  {
    name: 'Robert T.',
    business: 'Miami Landscaping',
    text: 'I was skeptical about websites at first. Kev explained everything clearly and showed me real results. My Google ranking improved in the first month.',
    stars: 5,
    delay: '200',
    initial: 'R',
    color: '#0E4094',
  },
  {
    name: 'Sofia R.',
    business: 'Doral Food Truck',
    text: 'Getting a website felt overwhelming until I found KevDigital. He handled everything — logo, content, even my Google Maps listing. Total game changer.',
    stars: 5,
    delay: '300',
    initial: 'S',
    color: '#FF6B35',
  },
  {
    name: 'James P.',
    business: 'Miami Beach Plumbing',
    text: 'We went from zero online presence to getting 5–10 new customer inquiries per week through the website. The ROI on $399 is incredible.',
    stars: 5,
    delay: '400',
    initial: 'J',
    color: '#00C2CB',
  },
  {
    name: 'Ana V.',
    business: 'Hialeah Cleaning Co.',
    text: 'Kev is responsive, professional, and genuinely cares about his clients\' success. The monthly plan is super affordable and he always answers fast.',
    stars: 5,
    delay: '500',
    initial: 'A',
    color: '#0E4094',
  },
];
---

<section class="relative py-24 overflow-hidden">
  <div class="glow-orb w-[400px] h-[400px] bg-teal-glow bottom-0 right-0 opacity-20 animate-glow-pulse" style="animation-delay: 2s;"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-14" data-animate>
      <span class="section-label">Testimonials</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-2 mb-4 leading-tight">
        Miami Business Owners<br /><span class="text-gradient-teal">Love KevDigital</span>
      </h2>
      <div class="flex items-center justify-center gap-3 mt-4">
        <div class="stars text-xl">★★★★★</div>
        <span class="text-kev-text font-semibold">5.0 / 5 rating</span>
        <span class="text-kev-muted text-sm">· Verified clients</span>
      </div>
    </div>

    <!-- Reviews grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {reviews.map((review) => (
        <div
          class="glass-card p-7 relative overflow-hidden group"
          data-animate
          style={`--delay: ${review.delay}ms`}
        >
          <!-- Quote mark watermark -->
          <div
            class="absolute top-4 right-5 text-6xl font-serif leading-none select-none pointer-events-none"
            style="color: rgba(0,194,203,0.06);"
          >
            "
          </div>

          <!-- Stars -->
          <div class="stars text-sm mb-4">★★★★★</div>

          <!-- Review text -->
          <p class="text-kev-text text-sm leading-relaxed mb-5 relative z-10">
            "{review.text}"
          </p>

          <!-- Reviewer -->
          <div class="flex items-center gap-3">
            <div
              class="w-10 h-10 rounded-full flex items-center justify-center text-white font-black text-sm flex-shrink-0"
              style={`background: ${review.color};`}
            >
              {review.initial}
            </div>
            <div>
              <p class="text-white font-semibold text-sm">{review.name}</p>
              <p class="text-kev-muted text-xs">{review.business}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Google badge -->
    <div class="mt-10 text-center" data-animate style="--delay: 500ms">
      <div
        class="inline-flex items-center gap-4 rounded-2xl px-6 py-4 border"
        style="background: rgba(13,30,53,0.7); border-color: #162840;"
      >
        <svg class="w-6 h-6 flex-shrink-0" viewBox="0 0 24 24" fill="none">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <div class="text-left">
          <div class="stars text-sm">★★★★★</div>
          <p class="text-kev-muted text-xs">5.0 on Google · Miami Web Design</p>
        </div>
        <a
          href="https://maps.google.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-kev-teal text-xs font-semibold hover:text-kev-tealLight transition-colors"
        >
          View Reviews →
        </a>
      </div>
    </div>
  </div>
</section>
