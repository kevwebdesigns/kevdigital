---
interface Props {
  checkoutUrl: string;
}
const { checkoutUrl } = Astro.props;
---

<div
  id="sticky-cart"
  class="fixed bottom-0 inset-x-0 z-50 md:hidden"
  style="backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); background: rgba(5,5,16,0.92); border-top: 1px solid rgba(124,58,237,0.3); box-shadow: 0 -4px 24px rgba(124,58,237,0.2);"
>
  <div class="flex items-center gap-3 px-4 py-3">
    <!-- Mini product info -->
    <div class="flex-1 min-w-0">
      <p class="text-white font-bold text-sm leading-tight truncate">Galaxy Projection Lamp</p>
      <div class="flex items-center gap-2 mt-0.5">
        <span class="text-white font-black text-base">$24.95</span>
        <span class="text-galaxy-muted text-xs line-through">$31.19</span>
        <span class="text-green-400 text-xs font-semibold">-20%</span>
      </div>
    </div>

    <!-- CTA button -->
    <a
      href={checkoutUrl}
      class="flex-shrink-0 bg-cta-gradient text-white font-bold text-sm py-3 px-6 rounded-full whitespace-nowrap"
      style="box-shadow: 0 0 20px rgba(124,58,237,0.5);"
    >
      ADD TO CART 🛒
    </a>
  </div>
</div>
