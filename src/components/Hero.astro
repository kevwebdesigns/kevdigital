---
interface Props {
  checkoutUrl: string;
}
const { checkoutUrl } = Astro.props;
---

<section id="hero" class="relative min-h-screen flex flex-col justify-center overflow-hidden">
  <!-- Galaxy background -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=1600&q=85&auto=format&fit=crop"
      alt="Galaxy background"
      class="w-full h-full object-cover object-center"
      loading="eager"
    />
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(5,5,16,0.95) 0%, rgba(10,0,30,0.88) 45%, rgba(5,5,16,0.65) 100%);"></div>
  </div>

  <div class="absolute top-0 left-0 w-[400px] h-[400px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(124,58,237,0.3) 0%, transparent 70%);"></div>
  <div class="absolute bottom-0 right-0 w-[350px] h-[350px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(59,130,246,0.2) 0%, transparent 70%);"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 pt-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">

      <!-- Left: Copy -->
      <div class="text-center lg:text-left order-2 lg:order-1">
        <div class="inline-flex items-center gap-2 bg-galaxy-purple/25 border border-galaxy-purple/50 rounded-full px-4 py-2 text-sm font-bold text-white mb-5 backdrop-blur-sm">
          <span class="text-red-400 animate-pulse">●</span> TRENDING ON TIKTOK · 10,000+ SOLD
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black leading-[1.05] mb-5">
          <span class="text-white">Turn Your Room Into</span><br />
          <span class="text-gradient">Another Universe</span>
        </h1>

        <p class="text-lg sm:text-xl text-galaxy-stardust/90 mb-6 max-w-lg mx-auto lg:mx-0 leading-relaxed">
          Project moons, planets & galaxies onto your walls and ceiling. Immersive. Effortless. Unforgettable.
        </p>

        <!-- Price above CTA -->
        <div class="flex items-center justify-center lg:justify-start gap-3 mb-6">
          <span class="text-4xl font-black text-white">$24.95</span>
          <div>
            <span class="text-galaxy-muted line-through text-lg block">$31.19</span>
            <span class="bg-green-500/20 text-green-400 border border-green-500/40 text-xs font-bold px-2 py-0.5 rounded-full">SAVE 20% TODAY</span>
          </div>
        </div>

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start mb-5">
          <a href={checkoutUrl} class="btn-primary text-xl py-5 px-10">
            🛒 Get Yours Today
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Urgency -->
        <div class="flex items-center justify-center lg:justify-start gap-2 mb-6">
          <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
          <span class="text-red-400 text-sm font-semibold">Only 23 left · 47 people viewing right now</span>
        </div>

        <!-- Trust bullets -->
        <div class="flex flex-wrap justify-center lg:justify-start gap-3 mb-6">
          {['🔌 USB Powered', '🪐 16 Slides Included', '🚚 Free Shipping', '↩️ 30-Day Returns'].map((b) => (
            <span class="inline-flex items-center gap-1.5 bg-white/10 border border-white/20 rounded-full px-3 py-1.5 text-sm text-white backdrop-blur-sm">{b}</span>
          ))}
        </div>

        <!-- Stars -->
        <div class="flex items-center justify-center lg:justify-start gap-3">
          <div class="flex -space-x-2">
            {['#7c3aed','#4f46e5','#a855f7','#6366f1','#8b5cf6'].map((c, i) => (
              <div class="w-8 h-8 rounded-full border-2 border-black/50 flex items-center justify-center text-xs font-black text-white" style={`background: ${c};`}>{String.fromCharCode(65 + i)}</div>
            ))}
          </div>
          <div>
            <div class="flex gap-0.5">{[1,2,3,4,5].map(() => <span class="text-galaxy-gold text-sm">★</span>)}</div>
            <p class="text-xs text-galaxy-muted">2,847 verified reviews · 4.9/5</p>
          </div>
        </div>
      </div>

      <!-- Right: Real lifestyle photo showing the projection effect -->
      <div class="order-1 lg:order-2 flex items-center justify-center">
        <div class="relative w-full max-w-md animate-float">
          <!-- Outer glow -->
          <div class="absolute -inset-4 rounded-3xl animate-glow-pulse pointer-events-none" style="background: radial-gradient(ellipse, rgba(124,58,237,0.4) 0%, transparent 70%);"></div>

          <!-- Main lifestyle image: galaxy projection in bedroom -->
          <div class="relative rounded-3xl overflow-hidden aspect-[4/5]" style="border: 1px solid rgba(168,85,247,0.5); box-shadow: 0 0 80px rgba(124,58,237,0.5), 0 0 160px rgba(124,58,237,0.2);">
            <img
              src="https://images.unsplash.com/photo-1419242902214-272b3f66ee7a?w=900&q=90&auto=format&fit=crop"
              alt="Galaxy projection lamp creating stunning space atmosphere in bedroom"
              class="w-full h-full object-cover"
              loading="eager"
            />
            <!-- Brand-consistent purple tint overlay -->
            <div class="absolute inset-0" style="background: linear-gradient(160deg, rgba(26,5,51,0.3) 0%, rgba(0,0,0,0.1) 40%, rgba(5,5,16,0.6) 100%);"></div>

            <!-- Floating badge bottom-left -->
            <div class="absolute bottom-5 left-5 right-5">
              <div class="glass-card px-4 py-3 backdrop-blur-md" style="background: rgba(5,5,16,0.85);">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full flex-shrink-0" style="background: radial-gradient(circle at 35% 35%, #e8e0d0, #b0a898, #504840); box-shadow: 0 0 12px rgba(168,85,247,0.6);"></div>
                  <div>
                    <p class="text-white font-bold text-sm">Moon projection</p>
                    <p class="text-galaxy-muted text-xs">Projects up to 280cm · Covers 12m²</p>
                  </div>
                  <div class="ml-auto flex gap-0.5">{[1,2,3,4,5].map(() => <span class="text-galaxy-gold text-xs">★</span>)}</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Floating planet badges -->
          <div class="absolute -top-4 -right-4 w-14 h-14 rounded-full animate-glow-pulse" style="background: radial-gradient(circle at 35% 35%, #93c5fd, #1e3a8a); box-shadow: 0 0 20px rgba(147,197,253,0.7);" title="Earth projection"></div>
          <div class="absolute -bottom-4 -left-4 w-10 h-10 rounded-full" style="background: radial-gradient(circle at 35% 35%, #fbbf24, #92400e); box-shadow: 0 0 16px rgba(251,191,36,0.6); animation: float 5s ease-in-out infinite 1s;" title="Jupiter projection"></div>
        </div>
      </div>

    </div>
  </div>
</section>
