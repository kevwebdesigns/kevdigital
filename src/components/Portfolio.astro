---
const projects = [
  {
    name: 'SF Towing',
    url: 'https://sftowing.netlify.app',
    displayUrl: 'sftowing.netlify.app',
    type: 'Towing & Roadside Assistance',
    tags: ['Local SEO', 'Mobile-First', 'Lead Generation'],
    delay: '0',
  },
  {
    name: 'Local Business',
    url: 'https://jolly-truffle-e2921f.netlify.app',
    displayUrl: 'jolly-truffle-e2921f.netlify.app',
    type: 'Miami Local Business',
    tags: ['Custom Design', 'Fast Loading', 'Google Ready'],
    delay: '150',
  },
];
---

<section id="portfolio" class="relative py-24 overflow-hidden">
  <div class="glow-orb w-[350px] h-[350px] bg-orange-glow -top-10 right-0 opacity-25 animate-glow-pulse"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-14" data-animate>
      <span class="section-label">Our Work</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-2 mb-4 leading-tight">
        Real Websites.<br /><span class="text-gradient-teal">Real Results.</span>
      </h2>
      <p class="text-kev-text/75 text-lg max-w-xl mx-auto">
        Every site we build is custom, fast, and designed to convert visitors into customers.
      </p>
    </div>

    <!-- Portfolio grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
      {projects.map((project) => (
        <div
          class="group"
          data-animate
          style={`--delay: ${project.delay}ms`}
        >
          <!-- Browser frame -->
          <div
            class="browser-frame transition-transform duration-500 group-hover:-translate-y-1"
            style="box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(0,194,203,0.1);"
          >
            <!-- Browser bar -->
            <div class="browser-bar">
              <div class="browser-dots">
                <div class="browser-dot" style="background:#FF5F57;"></div>
                <div class="browser-dot" style="background:#FEBC2E;"></div>
                <div class="browser-dot" style="background:#28C840;"></div>
              </div>
              <div class="browser-url">{project.displayUrl}</div>
            </div>
            <!-- Iframe content -->
            <div class="browser-content">
              <iframe
                src={project.url}
                title={`${project.name} website`}
                loading="lazy"
              ></iframe>
              <!-- Overlay to prevent interaction, acts as click-through to live site -->
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="frame-overlay flex items-end justify-center pb-5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                style="background: linear-gradient(to top, rgba(5,13,24,0.7) 0%, transparent 50%);"
              >
                <span
                  class="inline-flex items-center gap-2 text-white text-sm font-semibold px-5 py-2.5 rounded-full"
                  style="background: rgba(0,194,203,0.9);"
                >
                  View Live Site
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            </div>
          </div>

          <!-- Project info below frame -->
          <div class="mt-4 flex items-start justify-between gap-4 px-1">
            <div>
              <h3 class="text-white font-bold text-lg">{project.name}</h3>
              <p class="text-kev-muted text-sm">{project.type}</p>
            </div>
            <div class="flex flex-wrap gap-1.5 justify-end">
              {project.tags.map((tag) => (
                <span
                  class="text-[11px] font-semibold px-2.5 py-1 rounded-full"
                  style="background: rgba(0,194,203,0.1); color: #00C2CB; border: 1px solid rgba(0,194,203,0.2);"
                >
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA to join portfolio -->
    <div
      class="rounded-2xl p-8 md:p-12 text-center border relative overflow-hidden"
      style="background: linear-gradient(135deg, rgba(0,194,203,0.07) 0%, rgba(13,30,53,0.8) 100%); border-color: rgba(0,194,203,0.2);"
      data-animate
      style="--delay: 250ms"
    >
      <div
        class="absolute inset-0 rounded-2xl pointer-events-none"
        style="background: radial-gradient(ellipse at 50% 0%, rgba(0,194,203,0.1) 0%, transparent 70%);"
      ></div>
      <h3 class="relative text-white font-black text-2xl sm:text-3xl mb-3">
        Your Business Could Be Next
      </h3>
      <p class="relative text-kev-text/75 mb-7 max-w-lg mx-auto">
        Join Miami businesses that chose to stop being invisible online.
        Your website will be live in 7 days — guaranteed.
      </p>
      <div class="relative flex flex-col sm:flex-row gap-3 justify-center">
        <a href="#audit" class="btn-orange text-base py-4 px-8 rounded-full">
          Start My Website — $399
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="tel:+17868004865" class="btn-outline text-base py-4 px-8 rounded-full">
          Call (786) 800-4865
        </a>
      </div>
    </div>
  </div>
</section>
