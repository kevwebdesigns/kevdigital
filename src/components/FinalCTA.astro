---
interface Props {
  checkoutUrl: string;
}
const { checkoutUrl } = Astro.props;
---

<section class="relative py-28 overflow-hidden" style="background: linear-gradient(180deg, #050510 0%, #0d0025 40%, #1a0040 70%, #0d0025 100%);">
  <!-- Orbs -->
  <div class="glow-orb w-[600px] h-[600px] bg-purple-glow top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-35"></div>
  <div class="absolute inset-0 stars-bg opacity-70"></div>

  <!-- Floating planets decoration -->
  <div class="absolute top-16 left-8 w-14 h-14 rounded-full animate-float hidden sm:block" style="background: radial-gradient(circle at 35% 35%, #c8c8c8, #787068, #504840); box-shadow: 0 0 20px rgba(168,85,247,0.5); animation-delay: 0s;"></div>
  <div class="absolute bottom-20 right-10 w-10 h-10 rounded-full animate-float hidden sm:block" style="background: radial-gradient(circle at 35% 35%, #7ec8e3, #1a4a6e); box-shadow: 0 0 16px rgba(59,130,246,0.5); animation-delay: 2s;"></div>
  <div class="absolute top-1/3 right-20 w-8 h-8 rounded-full animate-float hidden lg:block" style="background: radial-gradient(circle at 35% 35%, #e87070, #8b1a1a); box-shadow: 0 0 12px rgba(232,112,112,0.4); animation-delay: 1s;"></div>
  <div class="absolute bottom-1/3 left-20 w-6 h-6 rounded-full animate-float hidden lg:block" style="background: radial-gradient(circle at 35% 35%, #daa520, #8b6914); box-shadow: 0 0 10px rgba(218,165,32,0.4); animation-delay: 3s;"></div>

  <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div data-animate>
      <!-- Moon emoji -->
      <div class="text-6xl mb-6">🌌</div>

      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mb-6 leading-tight">
        Bring The Galaxy<br />
        <span class="text-gradient">Home Tonight</span>
      </h2>

      <p class="text-galaxy-stardust/80 text-xl mb-3 max-w-2xl mx-auto leading-relaxed">
        Your dream room is one click away. Join 10,000+ people who transformed their space with the Galaxy Projection Lamp.
      </p>
      <p class="text-galaxy-muted mb-10">
        20% off today only · Free shipping · 30-day money back
      </p>

      <!-- CTA -->
      <a href={checkoutUrl} class="btn-primary text-2xl py-6 px-12 inline-flex">
        Get Yours Before They Sell Out
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>

      <!-- Trust icons -->
      <div class="flex items-center justify-center gap-6 mt-8 flex-wrap">
        {[
          { icon: '🔒', text: 'Secure checkout' },
          { icon: '🚚', text: 'Ships in 24hrs' },
          { icon: '⭐', text: 'Rated 4.9 / 5' },
        ].map((t) => (
          <div class="flex items-center gap-2 text-galaxy-muted text-sm">
            <span>{t.icon}</span>
            <span>{t.text}</span>
          </div>
        ))}
      </div>

      <p class="text-galaxy-muted/50 text-xs mt-6">
        © 2025 Galaxy Moon Lamp. All rights reserved.
      </p>
    </div>
  </div>
</section>
