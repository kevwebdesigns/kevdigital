---
const items = [
  { icon: '⚡', text: 'Sites Live in 7 Days' },
  { icon: '💰', text: '$399 One-Time Setup' },
  { icon: '🔒', text: '30-Day Money-Back Guarantee' },
  { icon: '📱', text: '100% Mobile-First Design' },
  { icon: '📍', text: 'Miami-Based Agency' },
  { icon: '🚫', text: 'No Contracts Ever' },
  { icon: '🔍', text: 'Google-Ready SEO Setup' },
  { icon: '💬', text: 'Real Human Support' },
  { icon: '✏️', text: 'Unlimited Revisions' },
  { icon: '🌐', text: 'Hosting Included' },
];
const doubled = [...items, ...items];
---

<div
  class="py-3 overflow-hidden"
  style="background: rgba(0,194,203,0.06); border-top: 1px solid rgba(0,194,203,0.15); border-bottom: 1px solid rgba(0,194,203,0.15);"
>
  <div class="flex animate-marquee whitespace-nowrap gap-10">
    {doubled.map((item) => (
      <span class="inline-flex items-center gap-2 text-sm font-medium text-kev-text flex-shrink-0">
        <span>{item.icon}</span>
        <span>{item.text}</span>
        <span class="ml-4 text-kev-teal/40">◆</span>
      </span>
    ))}
  </div>
</div>
