---
const reviews = [
  {
    name: 'Sarah M.',
    location: 'Austin, TX',
    avatar: 'SM', avatarColor: '#7c3aed',
    stars: 5,
    title: '"My room literally feels like a movie now."',
    body: "I bought this on a whim after seeing it on TikTok and I literally gasped when I turned it on. The moon projection on my ceiling looks so real. My friends all want one now.",
    verified: true, daysAgo: 2, delay: '0',
  },
  {
    name: 'Jake R.',
    location: 'Portland, OR',
    avatar: 'JR', avatarColor: '#4f46e5',
    stars: 5,
    title: '"Best TikTok purchase I\'ve ever made."',
    body: "Way better than expected for the price. The planet slides are so cool — I use the Saturn one as my default now. Sleep has been so much better since I started using this instead of my phone.",
    verified: true, daysAgo: 5, delay: '100',
  },
  {
    name: 'Priya D.',
    location: 'Chicago, IL',
    avatar: 'PD', avatarColor: '#a855f7',
    stars: 5,
    title: '"Way cooler than LED strips."',
    body: "I had RGB everywhere and nothing felt special. This is different — it creates an actual atmosphere, not just a color. My boyfriend and I use it every movie night now.",
    verified: true, daysAgo: 8, delay: '200',
  },
  {
    name: 'Tyler K.',
    location: 'Miami, FL',
    avatar: 'TK', avatarColor: '#6366f1',
    stars: 5,
    title: '"Bought it for my daughter. She loves it."',
    body: "She's 7 and was scared of the dark. Since we got this she actually looks forward to bedtime — she picks a different planet every night. Best parenting purchase in years.",
    verified: true, daysAgo: 11, delay: '300',
  },
  {
    name: 'Aisha L.',
    location: 'New York, NY',
    avatar: 'AL', avatarColor: '#8b5cf6',
    stars: 5,
    title: '"My content has never looked better."',
    body: "I'm a lifestyle creator and this is now in the background of every video I post. The galaxy projection just makes everything look premium. 10/10 recommend to any creator.",
    verified: true, daysAgo: 14, delay: '400',
  },
  {
    name: 'Marcus T.',
    location: 'Seattle, WA',
    avatar: 'MT', avatarColor: '#3b82f6',
    stars: 5,
    title: '"Surprised my girlfriend. She cried."',
    body: "Set it up with candles and roses before she got home. She walked in to a full galaxy projected on the ceiling. Best $25 I've ever spent on a date night.",
    verified: true, daysAgo: 18, delay: '500',
  },
];
---

<section class="relative py-24 bg-galaxy-deep overflow-hidden">
  <div class="glow-orb w-[400px] h-[400px] bg-purple-glow -top-16 left-1/2 -translate-x-1/2 opacity-20"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-5" data-animate>
      <span class="section-label">Verified Reviews</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-4 mb-4">
        10,000+ People Are <span class="text-gradient">Obsessed</span>
      </h2>

      <!-- Aggregate rating visual -->
      <div class="inline-flex items-center gap-4 bg-galaxy-gold/10 border border-galaxy-gold/30 rounded-2xl px-6 py-4 mt-3">
        <div>
          <div class="flex gap-1 mb-1">
            {[1,2,3,4,5].map(() => <span class="text-galaxy-gold text-2xl">★</span>)}
          </div>
          <p class="text-white font-black text-3xl leading-none">4.9</p>
          <p class="text-galaxy-muted text-xs">out of 5 stars</p>
        </div>
        <div class="text-left space-y-1.5">
          {[
            { stars: '5★', pct: 94 },
            { stars: '4★', pct: 4 },
            { stars: '3★', pct: 1 },
            { stars: '2★', pct: 1 },
          ].map((r) => (
            <div class="flex items-center gap-2">
              <span class="text-galaxy-muted text-xs w-6">{r.stars}</span>
              <div class="w-24 bg-white/10 rounded-full h-1.5">
                <div class="h-1.5 rounded-full bg-galaxy-gold" style={`width: ${r.pct}%;`}></div>
              </div>
              <span class="text-galaxy-muted text-xs">{r.pct}%</span>
            </div>
          ))}
        </div>
        <div class="text-left">
          <p class="text-white font-black text-xl">2,847</p>
          <p class="text-galaxy-muted text-xs">verified reviews</p>
          <p class="text-green-400 text-xs font-semibold mt-1">✓ All reviews verified</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mt-10">
      {reviews.map((r) => (
        <div
          class="glass-card p-7 flex flex-col gap-4 hover:border-galaxy-purple/40 transition-all duration-300 hover:-translate-y-1"
          data-animate
          style={`--delay: ${r.delay}ms`}
        >
          <!-- Stars -->
          <div class="flex gap-0.5">
            {[1,2,3,4,5].map(() => <span class="text-galaxy-gold text-base">★</span>)}
          </div>

          <p class="text-white font-bold text-base leading-snug">{r.title}</p>
          <p class="text-galaxy-muted text-sm leading-relaxed flex-1">{r.body}</p>

          <!-- Reviewer -->
          <div class="flex items-center gap-3 pt-3 border-t border-white/10">
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-xs font-black text-white flex-shrink-0" style={`background: ${r.avatarColor};`}>
              {r.avatar}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-white text-sm font-bold">{r.name}</p>
              <p class="text-galaxy-muted text-xs">{r.location} · {r.daysAgo} days ago</p>
            </div>
            <span class="flex-shrink-0 text-xs text-green-400 bg-green-400/10 border border-green-400/25 px-2 py-0.5 rounded-full whitespace-nowrap">
              ✓ Verified
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA from social proof -->
    <div class="text-center mt-12" data-animate style="--delay: 600ms">
      <p class="text-galaxy-stardust text-lg mb-2">Join 10,000+ happy customers.</p>
      <p class="text-galaxy-muted text-sm">Every review above is from a verified purchase.</p>
    </div>
  </div>
</section>
